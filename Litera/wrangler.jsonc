{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "litera",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SUPABASE_URL": "https://qgxiisgzwcsevzyaoxvl.supabase.co",
    "VITE_SUPABASE_URL": "https://qgxiisgzwcsevzyaoxvl.supabase.co",
    "VITE_SUPABASE_ANON_KEY": "sb_publishable_b9UI3PiZhUvPTcroS9oMOg_NyHBwtxw"
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "assets": {
    // Vite build output (npm run build)
    "directory": "./dist",
    "binding": "ASSETS",
    // React Router: unknown paths (/contacts, /book/123, ...) fall back to index.html
    "not_found_handling": "single-page-application",
    // Route API and health check requests to the Cloudflare Worker first
    "run_worker_first": ["/api/*", "/health"]
  }
}
